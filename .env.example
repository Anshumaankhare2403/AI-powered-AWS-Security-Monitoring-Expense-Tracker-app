# Database Configuration
DATABASE_URL=mysql+pymysql://tracker:trackerpass@localhost:3307/expensetracker
# For Docker Compose:
# DATABASE_URL=mysql+pymysql://tracker:trackerpass@db:3306/expensetracker

# Security & JWT Configuration
SECRET_KEY=change_this_to_a_secure_random_secret_in_production_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Settings
ENVIRONMENT=development
API_V1_STR=/api
PROJECT_NAME="Expense Tracker API"
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Server Configuration
HOST=0.0.0.0
PORT=8000
